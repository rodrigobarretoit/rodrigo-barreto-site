---
/*
 * Contact section — CTA cluster + meta table + LinkedIn profile badge.
 *
 * Button order (left → right, top-priority first):
 *   1. Email me     (primary — the fastest way to reach me)
 *   2. Book a call  (secondary — Cal.com scheduler)
 *   3. Request CV   (secondary — dedicated form page)
 *
 * Meta table (right column): email · LinkedIn · location · availability.
 * NO phone, NO street address. Public-safe only.
 *
 * LinkedIn badge:
 *   Sits below the two-column grid, centered. Rendered by LinkedIn's
 *   platform script (loaded once at the bottom of this component). The
 *   locale follows the current site language so the widget's built-in
 *   labels ("View profile", "See more…") match. If the visitor blocks the
 *   third-party script, they see the fallback link to the profile.
 */

import { site } from "../data/site";
import { tr, type Lang } from "../data/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = tr(lang);

const requestCvHref = lang === "en" ? "/request-cv/" : "/es/request-cv/";
const badgeLocale = lang === "en" ? "en_US" : "es_ES";
const badgeHref = "https://ie.linkedin.com/in/rodrigobarretoroa?trk=profile-badge";
---

<section id="contact" class="contact" aria-label={t("section.contact")}>
  <div class="container">
    <span class="section-eyebrow">{t("section.contact")}</span>

    <div class="contact__grid">
      <div>
        <h2 class="section-title">{t("section.contact")}</h2>
        <div class="contact__actions">
          <a href={`mailto:${site.email}`} class="btn btn--primary">{t("cta.email")}</a>
          <a href={site.scheduleUrl} class="btn btn--ghost" target="_blank" rel="noopener">
            {t("cta.bookCall")}
          </a>
          <a href={requestCvHref} class="btn btn--ghost">{t("cta.requestCv")}</a>
        </div>
      </div>

      <div class="contact__meta">
        <div class="contact__row">
          <span class="contact__label">{t("contact.email")}</span>
          <span class="contact__value">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </span>
        </div>
        <div class="contact__row">
          <span class="contact__label">{t("contact.location")}</span>
          <span class="contact__value">{site.location}</span>
        </div>
        <div class="contact__row">
          <span class="contact__label">{t("contact.availability")}</span>
          <span class="contact__value">{t("contact.availableNow")}</span>
        </div>
      </div>

      <!--
        LinkedIn profile badge as the third column of the Contact grid.
        The LinkedIn text row was removed from the meta table above because
        this card says the same thing more richly. Widget is rendered by
        LinkedIn's script (loaded once, below); if the third-party script
        is blocked, the fallback link becomes visible.
      -->
      <div class="contact__badge">
        <div
          class="badge-base LI-profile-badge"
          data-locale={badgeLocale}
          data-size="medium"
          data-theme="dark"
          data-type="VERTICAL"
          data-vanity="rodrigobarretoroa"
          data-version="v1"
        >
          <a class="badge-base__link LI-simple-link" href={badgeHref}>
            Rodrigo Manuel B.
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LinkedIn platform script — turns the div above into a live profile card.
     `async defer` keeps it off the critical path. Third-party origin, so the
     site's static hosting doesn't care; it just needs to be reachable at load. -->
<script
  src="https://platform.linkedin.com/badges/js/profile.js"
  async
  defer
  type="text/javascript"></script>

<style>
  .contact__actions {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /*
   * LinkedIn badge = 3rd column of the Contact grid on desktop.
   * The parent .contact__grid (in global.css) is overridden below to be
   * three columns wide when this component renders. On smaller screens
   * it stacks under the other two.
   */
  .contact__badge {
    display: flex;
    justify-content: center;
    min-width: 280px;
  }
  .contact__badge .badge-base {
    width: 100%;
    max-width: 320px;
  }
  /* Fallback link — visible only if LinkedIn's script is blocked. */
  .contact__badge .badge-base__link {
    color: var(--accent);
    text-decoration: underline;
    font-size: 0.95rem;
  }
</style>
