---
/*
 * Hero section — top of the profile page.
 *
 * Renders: role eyebrow, big name (with amber surname), pitch,
 * availability badge, CTAs, and a portrait card on the right.
 *
 * The portrait is a PLACEHOLDER with the RB initials.
 * When you have a real photo:
 *   1. Save it (JPG or WebP, portrait 3:4 works best) at
 *      /public/img/rodrigo-portrait.jpg
 *   2. In this file, uncomment the <img> below and delete the
 *      "hero__portrait-initials" span.
 */

import { site } from "../data/site";
import { hero } from "../data/content";
import { tr, type Lang } from "../data/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = tr(lang);
const h = hero[lang];
---

<section class="hero container">
  <div class="hero__grid">
    <div>
      <span class="hero__eyebrow">{h.eyebrow}</span>
      <h1 class="hero__title">
        <span>{h.firstName}</span>
        {" "}
        <span class="hero__title-accent">{h.lastName}</span>
      </h1>
      {h.pitch.map((paragraph, i) => (
        <p class:list={["hero__pitch", i === 0 && "hero__pitch--lead"]}>
          {paragraph}
        </p>
      ))}
      <div class="hero__availability">
        <span class="hero__dot" aria-hidden="true"></span>
        <span>{h.availability}</span>
      </div>
      <div class="hero__actions">
        <a href={lang === "en" ? "/request-cv/" : "/es/request-cv/"} class="btn btn--primary">{t("cta.downloadCv")}</a>
        <a href="#contact" class="btn btn--ghost">{t("cta.contact")}</a>
      </div>
    </div>

    <!-- Portrait card — single professional photo, no hover swap. -->
    <div class="hero__portrait" aria-label={`Portrait of ${site.name}`}>
      <img
        src="/img/rodrigo-portrait.png"
        alt={`${site.name} — ${site.role}`}
        class="hero__portrait-img"
        loading="eager"
      />
      <div class="hero__portrait-caption">
        <span>{site.name}</span>
        <span>{site.location}</span>
      </div>
    </div>
  </div>
</section>
