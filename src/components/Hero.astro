---
/*
 * Hero section — top of the profile page.
 *
 * Layout:
 *   - Eyebrow (role badge)
 *   - Name (H1, surname in amber)
 *   - Subtitle (positioning line — Enterprise IT Support & M365 Administration)
 *   - Pitch (2-3 paragraphs, first one bold as lead)
 *   - Availability badge
 *   - CTAs — primary "Let's talk" → #contact; secondary "Download CV" →
 *     direct PDF download (auto-disabled if the file isn't in /public/cv).
 *   - Portrait card (single static photo)
 *
 * Photo:
 *   The <img> below points to /img/rodrigo-portrait.png. If the file is
 *   missing the browser will show a broken-image icon — drop the photo at
 *   /public/img/rodrigo-portrait.png (or update the src if you use a different
 *   filename/format).
 */

import fs from "node:fs";
import path from "node:path";
import { site } from "../data/site";
import { hero } from "../data/content";
import { tr, type Lang } from "../data/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = tr(lang);
const h = hero[lang];

// If the portrait file isn't in /public/img, show a clear placeholder
// so the visitor sees something intentional instead of a broken image icon.
const portraitSrc = "/img/rodrigo-portrait.png";
const portraitExists = (() => {
  try {
    return fs.existsSync(path.join(process.cwd(), "public", portraitSrc));
  } catch {
    return false;
  }
})();
---

<section class="hero container">
  <div class="hero__grid">
    <div>
      <span class="hero__eyebrow">{h.eyebrow}</span>
      <h1 class="hero__title">
        <span>{h.firstName}</span>
        {" "}
        <span class="hero__title-accent">{h.lastName}</span>
      </h1>
      <p class="hero__subtitle">{h.subtitle}</p>
      {h.pitch.map((paragraph, i) => (
        <p class:list={["hero__pitch", i === 0 && "hero__pitch--lead"]}>
          {paragraph}
        </p>
      ))}
      <div class="hero__availability">
        <span class="hero__dot" aria-hidden="true"></span>
        <span>{h.availability}</span>
      </div>

      <div class="hero__actions">
        <!-- Primary: contact-first CTA -->
        <a href="#contact" class="btn btn--primary">{t("cta.letsTalk")}</a>
        <!-- Secondary: send visitors to the request-CV form. -->
        <a
          href={lang === "en" ? "/request-cv/" : "/es/request-cv/"}
          class="btn btn--ghost"
        >{t("cta.requestCv")}</a>
      </div>
    </div>

    <!-- Portrait card — single static photo, always visible on desktop and mobile. -->
    <div class="hero__portrait" aria-label={`Portrait of ${site.name}`}>
      {portraitExists ? (
        <img
          src={portraitSrc}
          alt={`${site.name}, ${site.role} in ${site.location.split(",")[0]} — professional headshot`}
          class="hero__portrait-img"
          loading="eager"
        />
      ) : (
        <div class="hero__portrait-placeholder" aria-live="polite">
          <strong>PLACEHOLDER</strong>
          <span>Upload photo to:</span>
          <code>public{portraitSrc}</code>
        </div>
      )}
      <div class="hero__portrait-caption">
        <span>{site.name}</span>
        <span>{site.location}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Missing-photo placeholder — clear signal to upload the file */
  .hero__portrait-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1rem;
    z-index: 1;
  }
  .hero__portrait-placeholder strong {
    color: var(--accent);
    letter-spacing: 0.24em;
    font-size: 0.72rem;
  }
  .hero__portrait-placeholder span {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .hero__portrait-placeholder code {
    color: var(--text);
    background: rgba(0, 0, 0, 0.35);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
  }
</style>
