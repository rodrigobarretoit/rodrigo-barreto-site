---
/*
 * Request CV form — powered by Netlify Forms.
 *
 * How it works:
 *   1. Form submits directly to Netlify's form endpoint (built-in when the
 *      form has `data-netlify="true"` and a `name="…"` attribute).
 *   2. Netlify stores the submission in the site's Forms panel and emails
 *      Rodrigo a notification (once he adds his email in
 *      Site settings → Forms → Form notifications).
 *   3. After submit, the visitor is redirected to /thanks (or /es/thanks).
 *
 * Anti-spam:
 *   - Honeypot field "bot-field" is hidden from humans. If a bot fills it,
 *     Netlify silently drops the submission.
 *   - Netlify's own spam heuristics catch most of the rest.
 *
 * Note for local dev:
 *   Netlify Forms only work on the deployed site. `npm run dev` will render
 *   the form fine but a submit will 404 because there's no Netlify backend
 *   locally. Test the actual submit on the live URL after deploy.
 */

import { tr, type Lang } from "../data/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = tr(lang);

const thanksHref = lang === "en" ? "/thanks/" : "/es/thanks/";
---

<form
  class="rcv-form"
  name="request-cv"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action={thanksHref}
>
  <!-- Netlify uses this hidden input to identify the form when it
       receives the POST (in some client-side setups it's required). -->
  <input type="hidden" name="form-name" value="request-cv" />

  <!-- Honeypot: humans don't see this; bots fill it. Netlify drops those. -->
  <p class="rcv-honeypot" aria-hidden="true">
    <label>
      {lang === "en" ? "Don't fill this out:" : "No completes esto:"}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="rcv-field">
    <label for="rcv-name">{t("requestCv.name")} <span aria-hidden="true">*</span></label>
    <input
      type="text"
      id="rcv-name"
      name="name"
      required
      autocomplete="name"
      minlength="2"
    />
  </div>

  <div class="rcv-field">
    <label for="rcv-company">{t("requestCv.company")} <span aria-hidden="true">*</span></label>
    <input
      type="text"
      id="rcv-company"
      name="company"
      required
      autocomplete="organization"
      minlength="2"
    />
  </div>

  <div class="rcv-field">
    <label for="rcv-email">{t("requestCv.email")} <span aria-hidden="true">*</span></label>
    <input
      type="email"
      id="rcv-email"
      name="email"
      required
      autocomplete="email"
    />
  </div>

  <div class="rcv-field">
    <label for="rcv-role">{t("requestCv.role")}</label>
    <input
      type="text"
      id="rcv-role"
      name="role"
      autocomplete="off"
    />
  </div>

  <div class="rcv-field">
    <label for="rcv-message">{t("requestCv.message")}</label>
    <textarea id="rcv-message" name="message" rows="4"></textarea>
  </div>

  <button type="submit" class="btn btn--primary rcv-submit">
    {t("requestCv.submit")}
  </button>

  <p class="rcv-note">{t("requestCv.note")}</p>
</form>

<style>
  .rcv-form {
    max-width: 560px;
    display: grid;
    gap: 1rem;
  }
  .rcv-honeypot {
    /* Hidden from humans, still in DOM for bots to find and fill */
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
    height: 0;
  }
  .rcv-field {
    display: grid;
    gap: 0.35rem;
  }
  .rcv-field label {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 600;
  }
  .rcv-field label span {
    color: var(--accent);
  }
  .rcv-field input,
  .rcv-field textarea {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    color: var(--text);
    font: 400 1rem var(--font-sans);
    transition: border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  .rcv-field input:focus,
  .rcv-field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);
  }
  .rcv-field textarea {
    resize: vertical;
    min-height: 100px;
  }
  .rcv-submit {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .rcv-note {
    font-size: 0.88rem;
    color: var(--text-dim);
    max-width: 60ch;
    line-height: 1.5;
  }
</style>
