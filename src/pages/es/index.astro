---
/*
 * Home / Perfil — Español. Mirror de index.astro con lang="es".
 * El JSON-LD Person es idéntico (mismo dato, mismo Google).
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import Timeline from "../../components/Timeline.astro";
import Skills from "../../components/Skills.astro";
import Certifications from "../../components/Certifications.astro";
import ClosingStatement from "../../components/ClosingStatement.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

const lang = "es" as const;
const title = "Rodrigo Barreto | Especialista en Soporte IT en Dublín";
const description =
  "Especialista en Soporte IT en Dublín con más de 10 años en Microsoft 365, Intune y Entra ID. Proyectos reales de gestión de dispositivos, identidad y ciclo de vida de activos.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rodrigo Manuel Barreto Roa",
  alternateName: "Rodrigo Barreto",
  jobTitle: "IT Support Specialist",
  url: `https://${site.domain}`,
  sameAs: [site.linkedin.href],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Dublin",
    addressCountry: "IE",
  },
  knowsAbout: [
    "Microsoft 365",
    "Entra ID",
    "Microsoft Intune",
    "Endpoint Management",
    "Identity and Access Management",
    "IT Support",
    "ITIL",
    "IT Asset Lifecycle",
  ],
  knowsLanguage: ["Spanish", "English", "Portuguese"],
  alumniOf: [
    "CCT College Dublin",
    "Universidad Nacional de Villarrica",
  ],
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  path={Astro.url.pathname}
  jsonLd={jsonLd}
>
  <Nav slot="nav" lang={lang} path={Astro.url.pathname} page="profile" />

  <Hero lang={lang} />
  <QuickFacts lang={lang} />
  <Timeline lang={lang} />
  <Skills lang={lang} />
  <Certifications lang={lang} />
  <ClosingStatement lang={lang} />
  <Contact lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
