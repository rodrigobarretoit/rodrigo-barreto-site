---
/*
 * Proof page — English.
 *
 * Loads all English proof cards from Content Collections, filters out drafts,
 * sorts by `order`, and renders a grid. Category filter is client-side
 * (see /scripts/main.js).
 *
 * Two card layouts:
 *   - type: "case"      → Challenge / What I did / Result mini case study
 *   - type: "community" → Free-form summary paragraph
 */

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { tr } from "../data/ui";
import { site } from "../data/site";

const lang = "en" as const;
const t = tr(lang);

const title = "Rodrigo Barreto | Case Studies in IT Support and Microsoft 365";
const description =
  "Mini case studies from Rodrigo Barreto: PC refresh in Dublin financial services, endpoint management at scale, multi-tenant Microsoft 365 administration, and documentation-led resolution.";

const entries = (await getCollection("proof", ({ id, data }) =>
  id.startsWith("en/") && !data.draft
)).sort((a, b) =>
  a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);

const filters = [
  { key: "all", label: t("proof.filterAll") },
  { key: "case", label: t("proof.filterCase") },
  { key: "community", label: t("proof.filterCommunity") },
];

const typeLabels: Record<string, string> = {
  case: t("proof.filterCase"),
  community: t("proof.filterCommunity"),
};
---

<BaseLayout lang={lang} title={title} description={description} path={Astro.url.pathname}>
  <Nav slot="nav" lang={lang} path={Astro.url.pathname} page="proof" />

  <section class="proof-header container">
    <span class="section-eyebrow">{t("proof.title")}</span>
    <h1>{t("proof.title")}</h1>
    <p>{t("proof.lead")}</p>
  </section>

  <div class="container">
    <div class="proof-filters" role="group" aria-label="Filter">
      {filters.map((f, i) => (
        <button
          type="button"
          class="proof-filter"
          data-filter={f.key}
          aria-pressed={i === 0}
        >{f.label}</button>
      ))}
    </div>

    <div class="proof-grid" id="proof-grid">
      {entries.map((entry) => (
        <article class="proof-card reveal" data-type={entry.data.type}>
          <span class="proof-card__type">{typeLabels[entry.data.type] ?? entry.data.type}</span>
          <h3 class="proof-card__title">{entry.data.title}</h3>

          {entry.data.type === "case" ? (
            <div class="proof-card__case">
              {entry.data.challenge && (
                <div class="proof-card__row">
                  <span class="proof-card__row-label">{t("proof.caseChallenge")}</span>
                  <p class="proof-card__row-text">{entry.data.challenge}</p>
                </div>
              )}
              {entry.data.what && (
                <div class="proof-card__row">
                  <span class="proof-card__row-label">{t("proof.caseWhat")}</span>
                  <p class="proof-card__row-text">{entry.data.what}</p>
                </div>
              )}
              {entry.data.result && (
                <div class="proof-card__row proof-card__row--result">
                  <span class="proof-card__row-label">{t("proof.caseResult")}</span>
                  <p class="proof-card__row-text">{entry.data.result}</p>
                </div>
              )}
            </div>
          ) : (
            <p class="proof-card__summary">{entry.data.summary}</p>
          )}

          <div class="proof-card__tags">
            {entry.data.tags.map((tag) => (
              <span class="proof-card__tag">{tag}</span>
            ))}
          </div>

          <div class="proof-card__footer">
            <span class="proof-card__date">{entry.data.date}</span>
            <div class="proof-card__links">
              {(entry.data.links ?? []).map((link) => (
                <a href={link.href} class="proof-card__link"
                   target={link.href.startsWith("http") ? "_blank" : undefined}
                   rel={link.href.startsWith("http") ? "noopener" : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="proof-back">
      <a href="/">{t("proof.back")}</a>
      <span>{site.name} · {site.domain}</span>
    </div>
  </div>

  <Footer lang={lang} />
</BaseLayout>
