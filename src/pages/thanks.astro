---
/*
 * Thanks page — shown after a successful Request CV submission.
 * Netlify's form endpoint redirects here (`action="/thanks/"` on the form).
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { tr } from "../data/ui";

const lang = "en" as const;
const t = tr(lang);
---

<BaseLayout
  lang={lang}
  title="Rodrigo Barreto | Message received"
  description="Your request has been received. Rodrigo Barreto will reply within 24 hours."
  path={Astro.url.pathname}
  noindex
>
  <Nav slot="nav" lang={lang} path={Astro.url.pathname} page="profile" />

  <section class="thanks container">
    <div class="thanks__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="56" height="56" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </div>
    <h1>{t("thanks.title")}</h1>
    <p>{t("thanks.body")}</p>
    <a href="/" class="btn btn--primary thanks__cta">{t("thanks.back")}</a>
  </section>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .thanks {
    padding-block: clamp(6rem, 12vw, 10rem);
    text-align: center;
    display: grid;
    place-items: center;
    gap: 1.5rem;
  }
  .thanks__icon {
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--accent-soft);
  }
  .thanks h1 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .thanks p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 52ch;
    line-height: 1.55;
  }
  .thanks__cta { margin-top: 1rem; }
</style>
